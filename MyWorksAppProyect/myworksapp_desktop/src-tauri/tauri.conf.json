{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyWorksApp Desktop Hub",
  "version": "0.1.0",
  "identifier": "cl.myworksapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyWorksApp Admin",
        "width": 1360,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://wxqrfcqifkfgawrnqmnj.supabase.co; connect-src 'self' http://127.0.0.1:3001 http://127.0.0.1:54321 https://wxqrfcqifkfgawrnqmnj.supabase.co wss://wxqrfcqifkfgawrnqmnj.supabase.co; font-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["myworksapp-admin"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5OEE4ODQyRUIxRTVDMjEKUldRaFhCN3JRb2lLeVNReGI2NVZ6WE9VRzl1c2pyQmVWa2xVaFlBL05FMDBKRGh2Vk0vMnVPRTYK",
      "endpoints": ["https://github.com/nicoussj/Proyecto-Titulo-MyWorksApp/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
