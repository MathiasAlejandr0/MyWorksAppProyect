@startuml
title Casos de uso — MyWorksApp\nComunicación, reputación y disputas
skinparam shadowing false
skinparam handwritten false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 16
skinparam ActorFontSize 16
skinparam UseCaseFontSize 16
skinparam PackageFontSize 16
skinparam RectangleFontSize 16
skinparam ArrowFontSize 14
skinparam linetype ortho
left to right direction
hide circle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #00205B
  FontColor #00205B
}
skinparam rectangle {
  BackgroundColor #FCFCFD
  BorderColor #00205B
  FontColor #00205B
}
skinparam package {
  BackgroundColor #F4F6F8
  BorderColor #00205B
  FontColor #00205B
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #00205B
  FontColor #00205B
}

actor "Cliente registrado" as CR
actor "Profesional" as P

rectangle "MyWorksApp — Seguimiento y comunicación (b)" {
  usecase "CU-18 Calificar al profesional" as UC18
  usecase "CU-19 Calificar al cliente" as UC19
  usecase "CU-21 Abrir disputa y\nproponer un acuerdo" as UC21
  usecase "CU-23 Chatear sobre un trabajo" as UC23
  usecase "CU-24 Recibir y gestionar\nnotificaciones" as UC24
}

' Caso referenciado de otro paquete (fuera del límite)
usecase "CU-17 Recibir conforme y\nliberar el pago" as UC17

CR -- UC18
P -- UC19
CR -- UC21
P -- UC21
CR -- UC23
P -- UC23
CR -- UC24
P -- UC24
UC18 ..> UC17 : <<extend>>
UC21 ..> UC17 : <<extend>>
@enduml
