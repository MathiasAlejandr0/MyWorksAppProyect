@startuml
title Casos de uso — MyWorksApp\nSeguridad / autenticación
skinparam shadowing false
skinparam handwritten false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 16
skinparam ActorFontSize 16
skinparam UseCaseFontSize 16
skinparam PackageFontSize 16
skinparam RectangleFontSize 16
skinparam ArrowFontSize 14
skinparam linetype ortho
left to right direction
hide circle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #00205B
  FontColor #00205B
}
skinparam rectangle {
  BackgroundColor #FCFCFD
  BorderColor #00205B
  FontColor #00205B
}
skinparam package {
  BackgroundColor #F4F6F8
  BorderColor #00205B
  FontColor #00205B
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #00205B
  FontColor #00205B
}

actor "Visitante" as V
actor "Cliente registrado" as CR
actor "Profesional" as P
actor "Supabase Auth / correo" as AUTH <<sistema externo>>

rectangle "MyWorksApp — Seguridad / Auth" {
  usecase "CU-01 Registrarse" as UC01
  usecase "CU-02 Iniciar sesión" as UC02
  usecase "CU-03 Recuperar contraseña" as UC03
  usecase "CU-04 Ejercer derechos sobre\nlos datos (exportar /\neliminar cuenta)" as UC04
}

V -- UC01
AUTH -- UC01
CR -- UC02
P -- UC02
CR -- UC03
P -- UC03
AUTH -- UC03
CR -- UC04
P -- UC04
@enduml
