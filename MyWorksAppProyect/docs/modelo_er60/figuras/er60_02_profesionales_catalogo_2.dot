digraph x {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.05", nodesep="0.25", ranksep="0.4", splines="spline", rankdir="TB", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#8A5A12", penwidth="1.3", arrowsize="0.8", dir="both"];
"categorias_servicio" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>categorias_servicio</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"servicios" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>servicios</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><i>categoria</i></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 8 atributos más (diccionario)</font></td></tr></table>>];
"configuraciones_servicio" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>configuraciones_servicio</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><i>id_servicio</i></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"portafolio_trabajador" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>portafolio_trabajador</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><i>id_trabajador</i></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 4 atributos más (diccionario)</font></td></tr></table>>];
"impulsos" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>impulsos</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><i>id_trabajador</i></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 4 atributos más (diccionario)</font></td></tr></table>>];
"configuraciones_servicio" -> "servicios" [arrowtail="teeodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_servicio</font>>];
"servicios" -> "categorias_servicio" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">categoria</font>>];
"portafolio_trabajador" -> "impulsos" [style="invis", dir="none"];
}