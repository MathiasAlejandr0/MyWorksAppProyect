digraph x {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.05", nodesep="0.25", ranksep="0.4", splines="spline", rankdir="LR", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#8A5A12", penwidth="1.3", arrowsize="0.8", dir="both"];
"trabajadores" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>trabajadores</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id_usuario</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><i>id_comuna</i></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text?</font><font point-size="9" color="#7A1F1F"> → comunas</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 25 atributos más (diccionario)</font></td></tr></table>>];
"trabajador_precios" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>trabajador_precios</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id_usuario</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>codigo</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 1 atributo más (diccionario)</font></td></tr></table>>];
"trabajador_horarios" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>trabajador_horarios</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 6 atributos más (diccionario)</font></td></tr></table>>];
"trabajador_horas_publicadas" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>trabajador_horas_publicadas</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id_usuario</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>dia_semana</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">smallint</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>hora</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">time</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 1 atributo más (diccionario)</font></td></tr></table>>];
"trabajador_servicios_extra" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>trabajador_servicios_extra</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id_usuario</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 4 atributos más (diccionario)</font></td></tr></table>>];
"trabajador_servicios" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#8A5A12"><tr><td colspan="3" bgcolor="#8A5A12" align="left"><font color="white" point-size="11"><b>trabajador_servicios</b></font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>id_trabajador</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#F6EBD6"><font point-size="10"><b><u>categoria_servicio</u></b></font></td><td align="left" bgcolor="#F6EBD6"><font point-size="9" color="#444444">text</font><font point-size="9" color="#7A1F1F"> → categorias_servicio</font></td></tr></table>>];
"trabajador_horarios" -> "trabajadores" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
"trabajador_horas_publicadas" -> "trabajadores" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
"trabajador_precios" -> "trabajadores" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
"trabajador_servicios" -> "trabajadores" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_trabajador</font>>];
"trabajador_servicios_extra" -> "trabajadores" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
}