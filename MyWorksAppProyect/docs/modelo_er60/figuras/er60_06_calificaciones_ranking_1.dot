digraph x {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.05", nodesep="0.25", ranksep="0.4", splines="spline", rankdir="LR", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#2C4A6E", penwidth="1.3", arrowsize="0.8", dir="both"];
"calificaciones" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#2C4A6E"><tr><td colspan="3" bgcolor="#2C4A6E" align="left"><font color="white" point-size="11"><b>calificaciones</b></font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_trabajo</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font><font point-size="9" color="#7A1F1F"> → trabajos</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_calificado</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 7 atributos más (diccionario)</font></td></tr></table>>];
"senales_resena" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#2C4A6E"><tr><td colspan="3" bgcolor="#2C4A6E" align="left"><font color="white" point-size="11"><b>senales_resena</b></font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_calificacion</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>resuelto_por</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 6 atributos más (diccionario)</font></td></tr></table>>];
"calificaciones_cliente" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#2C4A6E"><tr><td colspan="3" bgcolor="#2C4A6E" align="left"><font color="white" point-size="11"><b>calificaciones_cliente</b></font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_trabajo</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font><font point-size="9" color="#7A1F1F"> → trabajos</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_cliente</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_trabajador</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"eventos_ranking" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#2C4A6E"><tr><td colspan="3" bgcolor="#2C4A6E" align="left"><font color="white" point-size="11"><b>eventos_ranking</b></font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_trabajador</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><i>id_trabajo</i></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text?</font><font point-size="9" color="#7A1F1F"> → trabajos</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"ranking_aprendizaje" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#2C4A6E"><tr><td colspan="3" bgcolor="#2C4A6E" align="left"><font color="white" point-size="11"><b>ranking_aprendizaje</b></font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 5 atributos más (diccionario)</font></td></tr></table>>];
"ranking_config" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#2C4A6E"><tr><td colspan="3" bgcolor="#2C4A6E" align="left"><font color="white" point-size="11"><b>ranking_config</b></font></td></tr><tr><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DDE5F0"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DDE5F0"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 15 atributos más (diccionario)</font></td></tr></table>>];
"senales_resena" -> "calificaciones" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_calificacion</font>>];
"calificaciones_cliente" -> "eventos_ranking" [style="invis", dir="none"];
"ranking_aprendizaje" -> "ranking_config" [style="invis", dir="none"];
}