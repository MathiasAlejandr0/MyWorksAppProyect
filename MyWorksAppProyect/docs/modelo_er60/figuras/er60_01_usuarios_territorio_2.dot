digraph x {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.05", nodesep="0.25", ranksep="0.4", splines="spline", rankdir="TB", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#1F4E79", penwidth="1.3", arrowsize="0.8", dir="both"];
"direcciones_cliente" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>direcciones_cliente</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"verificacion_eventos" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>verificacion_eventos</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_actor</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"paises" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>paises</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 2 atributos más (diccionario)</font></td></tr></table>>];
"regiones" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>regiones</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_pais</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 2 atributos más (diccionario)</font></td></tr></table>>];
"comunas" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>comunas</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_region</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 4 atributos más (diccionario)</font></td></tr></table>>];
"comunas" -> "regiones" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_region</font>>];
"regiones" -> "paises" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_pais</font>>];
"direcciones_cliente" -> "verificacion_eventos" [style="invis", dir="none"];
}