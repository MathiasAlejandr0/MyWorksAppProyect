digraph x {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.05", nodesep="0.25", ranksep="0.4", splines="spline", rankdir="LR", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#1F4E79", penwidth="1.3", arrowsize="0.8", dir="both"];
"perfiles" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>perfiles</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → auth.users</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 9 atributos más (diccionario)</font></td></tr></table>>];
"codigos_restablecimiento" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>codigos_restablecimiento</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 5 atributos más (diccionario)</font></td></tr></table>>];
"consentimientos_usuario" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>consentimientos_usuario</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 5 atributos más (diccionario)</font></td></tr></table>>];
"dispositivos_push" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>dispositivos_push</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>token</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"suscripciones" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>suscripciones</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 6 atributos más (diccionario)</font></td></tr></table>>];
"bloqueos_usuario" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1F4E79"><tr><td colspan="3" bgcolor="#1F4E79" align="left"><font color="white" point-size="11"><b>bloqueos_usuario</b></font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_bloqueador</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DCE8F5"><font point-size="10"><i>id_bloqueado</i></font></td><td align="left" bgcolor="#DCE8F5"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 1 atributo más (diccionario)</font></td></tr></table>>];
"bloqueos_usuario" -> "perfiles" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_bloqueado, id_bloqueador</font>>];
"codigos_restablecimiento" -> "perfiles" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
"consentimientos_usuario" -> "perfiles" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
"dispositivos_push" -> "perfiles" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
"suscripciones" -> "perfiles" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_usuario</font>>];
}