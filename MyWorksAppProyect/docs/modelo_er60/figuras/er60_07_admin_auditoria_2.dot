digraph x {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.05", nodesep="0.25", ranksep="0.4", splines="spline", rankdir="LR", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#6B2737", penwidth="1.3", arrowsize="0.8", dir="both"];
"eventos_abuso" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#6B2737"><tr><td colspan="3" bgcolor="#6B2737" align="left"><font color="white" point-size="11"><b>eventos_abuso</b></font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 6 atributos más (diccionario)</font></td></tr></table>>];
"registros_error_app" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#6B2737"><tr><td colspan="3" bgcolor="#6B2737" align="left"><font color="white" point-size="11"><b>registros_error_app</b></font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 8 atributos más (diccionario)</font></td></tr></table>>];
"eventos_analitica" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#6B2737"><tr><td colspan="3" bgcolor="#6B2737" align="left"><font color="white" point-size="11"><b>eventos_analitica</b></font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 4 atributos más (diccionario)</font></td></tr></table>>];
"encuestas_testing" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#6B2737"><tr><td colspan="3" bgcolor="#6B2737" align="left"><font color="white" point-size="11"><b>encuestas_testing</b></font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 8 atributos más (diccionario)</font></td></tr></table>>];
"encuesta_testing_respuestas" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#6B2737"><tr><td colspan="3" bgcolor="#6B2737" align="left"><font color="white" point-size="11"><b>encuesta_testing_respuestas</b></font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">PK,FK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><b><u>id_encuesta</u></b></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3DDE2"><font point-size="10"><b><u>item</u></b></font></td><td align="left" bgcolor="#F3DDE2"><font point-size="9" color="#444444">smallint</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 1 atributo más (diccionario)</font></td></tr></table>>];
"encuesta_testing_respuestas" -> "encuestas_testing" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_encuesta</font>>];
"eventos_abuso" -> "registros_error_app" [style="invis", dir="none"];
"registros_error_app" -> "eventos_analitica" [style="invis", dir="none"];
}