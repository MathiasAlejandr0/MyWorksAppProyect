digraph x {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.05", nodesep="0.25", ranksep="0.4", splines="spline", rankdir="TB", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#1B6B4A", penwidth="1.3", arrowsize="0.8", dir="both"];
"disputas" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1B6B4A"><tr><td colspan="3" bgcolor="#1B6B4A" align="left"><font color="white" point-size="11"><b>disputas</b></font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_trabajo</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font><font point-size="9" color="#7A1F1F"> → trabajos</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>abierta_por</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>resuelta_por</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 11 atributos más (diccionario)</font></td></tr></table>>];
"disputa_mensajes" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1B6B4A"><tr><td colspan="3" bgcolor="#1B6B4A" align="left"><font color="white" point-size="11"><b>disputa_mensajes</b></font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_disputa</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_autor</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">uuid?</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 3 atributos más (diccionario)</font></td></tr></table>>];
"mensajes" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1B6B4A"><tr><td colspan="3" bgcolor="#1B6B4A" align="left"><font color="white" point-size="11"><b>mensajes</b></font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_trabajo</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font><font point-size="9" color="#7A1F1F"> → trabajos</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_remitente</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_destinatario</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 5 atributos más (diccionario)</font></td></tr></table>>];
"notificaciones" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1B6B4A"><tr><td colspan="3" bgcolor="#1B6B4A" align="left"><font color="white" point-size="11"><b>notificaciones</b></font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_usuario</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">uuid</font><font point-size="9" color="#7A1F1F"> → perfiles</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 6 atributos más (diccionario)</font></td></tr></table>>];
"tickets_soporte" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#1B6B4A"><tr><td colspan="3" bgcolor="#1B6B4A" align="left"><font color="white" point-size="11"><b>tickets_soporte</b></font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#555555">FK</font></td><td align="left" bgcolor="#DAF0E5"><font point-size="10"><i>id_trabajo</i></font></td><td align="left" bgcolor="#DAF0E5"><font point-size="9" color="#444444">text?</font><font point-size="9" color="#7A1F1F"> → trabajos</font></td></tr><tr><td colspan="3" align="left"><font point-size="9" color="#555555">+ 6 atributos más (diccionario)</font></td></tr></table>>];
"disputa_mensajes" -> "disputas" [arrowtail="crowodot", arrowhead="teetee", label=<<font point-size="9" color="#555555">id_disputa</font>>];
"mensajes" -> "notificaciones" [style="invis", dir="none"];
"notificaciones" -> "tickets_soporte" [style="invis", dir="none"];
}