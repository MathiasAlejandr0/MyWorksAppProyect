digraph general {
graph [fontname="DejaVu Sans", bgcolor="white", pad="0.3", nodesep="0.3", ranksep="0.9", splines="spline", labelloc="t", labeljust="l"];
node [shape=plaintext, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", color="#444444", penwidth="1.6", arrowsize="1.3", dir="both"];

rankdir="LR"; nodesep="0.15"; ranksep="0.6"; concentrate="true";
label=<<font point-size="56"><b>MyWorksApp · Modelo entidad-relación general</b></font><br/><font point-size="34" color="#555555">52 tablas del esquema public agrupadas en 7 dominios · líneas = claves foráneas (pata de gallo = muchos) · punteadas = relaciones lógicas</font>>;
