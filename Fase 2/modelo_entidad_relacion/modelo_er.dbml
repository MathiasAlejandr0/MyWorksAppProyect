Ref: senales_resena.id_calificacion > calificaciones.{id} [delete: cascade]
Ref: senales_resena.resuelto_por > perfiles.{id} [delete: set null]
Ref: servicios.categoria > categorias_servicio.{id} [delete: no action]
Ref: suscripciones.id_usuario > perfiles.{id} [delete: cascade]
Ref: tickets_soporte.id_trabajo > trabajos.{id} [delete: set null]
Ref: trabajador_horarios.id_usuario > trabajadores.{id_usuario} [delete: cascade]
Ref: trabajador_horas_publicadas.id_usuario > trabajadores.{id_usuario} [delete: cascade]
Ref: trabajador_precios.id_usuario > trabajadores.{id_usuario} [delete: cascade]
Ref: trabajador_servicios.categoria_servicio > categorias_servicio.{id} [delete: no action]
Ref: trabajador_servicios.id_trabajador > trabajadores.{id_usuario} [delete: cascade]
Ref: trabajador_servicios_extra.id_usuario > trabajadores.{id_usuario} [delete: cascade]
Ref: trabajadores.id_comuna > comunas.{id} [delete: set null]
Ref: trabajadores.id_usuario - perfiles.{id} [delete: cascade]
Ref: trabajos.id_servicio > servicios.{id} [delete: set null]
Ref: trabajos.id_usuario > perfiles.{id} [delete: cascade]
Ref: trabajos.id_trabajador > perfiles.{id} [delete: set null]
Ref: trabajos.id_comuna > comunas.{id} [delete: set null]
Ref: trabajos.id_cotizacion_seleccionada > propuestas_cotizacion.{id} [delete: set null]
Ref: ubicacion_en_vivo.id_trabajo - trabajos.{id} [delete: cascade]
Ref: ubicacion_en_vivo.id_trabajador > trabajadores.{id_usuario} [delete: cascade]
Ref: verificacion_eventos.id_actor > perfiles.{id} [delete: set null]
Ref: verificacion_eventos.id_usuario > perfiles.{id} [delete: cascade]
// perfiles.id referencia auth.users.id (esquema auth de Supabase, ON DELETE CASCADE)

// Relaciones lógicas (sin FOREIGN KEY física):
//   metodos_pago_oneclick.(id_trabajo_pendiente) -> trabajos.(id) — trabajo que espera la inscripción Oneclick para cobrarse
//   bloqueos_pin_inicio.(pin_ok_usuario) -> perfiles.(id) — usuario que validó el PIN (ventana pin_ok_hasta)
//   trabajos.(id_trabajador, id_sku_servicio) -> trabajador_precios.(id_usuario, codigo) — SKU de precio elegido; también admite 'tier_<n>', por eso no es FK

TableGroup usuarios_territorio { // Usuarios, autenticación y territorio
  perfiles
  codigos_restablecimiento
  consentimientos_usuario
  dispositivos_push
  verificacion_eventos
  suscripciones
  bloqueos_usuario
  paises
  regiones
  comunas
}
TableGroup profesionales_catalogo { // Profesionales, servicios y precios
  trabajadores
  trabajador_precios
  trabajador_servicios
  trabajador_servicios_extra
  trabajador_horarios
  trabajador_horas_publicadas
  portafolio_trabajador
  impulsos
  categorias_servicio
  servicios
  configuraciones_servicio
}
TableGroup trabajos_reservas { // Trabajos, reservas, reprogramación y PIN
  trabajos
  propuestas_cotizacion
  propuesta_cotizacion_items
  acuerdos_trabajo
  cancelaciones_trabajo
  reprogramaciones_trabajo
  pines_inicio_trabajo
  bloqueos_pin_inicio
  intentos_pin_inicio
  fotos_trabajo
  ubicacion_en_vivo
}
TableGroup pagos_escrow { // Pagos, escrow, liquidaciones y cuentas bancarias
  pagos
  ordenes_cambio
  liquidaciones
  metodos_pago_oneclick
  cuentas_bancarias
}
TableGroup comunicacion_disputas { // Comunicación, notificaciones, disputas y soporte
  mensajes
  notificaciones
  disputas
  disputa_mensajes
  tickets_soporte
}
TableGroup calificaciones_ranking { // Calificaciones y ranking
  calificaciones
  calificaciones_cliente
  senales_resena
  eventos_ranking
  ranking_aprendizaje
  ranking_config
}
TableGroup admin_auditoria { // Administración, moderación y auditoría
  acciones_pendientes
  reportes
  eventos_abuso
  registros_error_app
  eventos_analitica
  banderas_funcionalidad
  app_config
  encuestas_testing
  encuesta_testing_respuestas
}
