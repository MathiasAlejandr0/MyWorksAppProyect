Project MyWorksApp {
  database_type: 'PostgreSQL'
  Note: 'Modelo lógico v2.4 · 52 tablas public · 2026-11-16 (America/Santiago) · alineado a la BD viva wxqrfcqifkfgawrnqmnj hasta la migración 20261115234447 (catalogo_plomeria_gasfiteria_distintos). Archivo de migración en el repo: 20261115234447_catalogo_plomeria_gasfiteria_distintos.sql. Diccionario generado desde information_schema y pg_catalog (solo lectura). No hay tipos ENUM ni vistas en public: los estados se restringen con CHECK. No ejecutar el SQL de consulta contra producción.'
}

Table perfiles {
  id uuid [pk, not null, default: gen_random_uuid()]
  nombre text [not null, default: "''"]
  correo text
  rol text [not null, default: "'user'", note: 'usuario | trabajador | administrador']
  estado_cuenta text [not null, default: "'active'", note: 'activo | suspendido | bloqueado | eliminado']
  ruta_foto_perfil text
  creado_en text [not null, default: "to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD\"T\"HH24:MI:SS.US'::text)"]
  reputacion_cliente numeric(3,2)
  calificaciones_cliente integer [not null, default: 0]

  Note: 'Identidad de la aplicación: perfiles.id coincide con auth.users.id (esquema auth de Supabase, fuera de public). El default de rol es ’user’ y el de estado_cuenta es ’active’ (valores en inglés de las primeras migraciones). En la práctica también se usan valores en español: usuario, trabajador, administrador, soporte y qa; activo, suspendido, bloqueado y eliminado. is_admin() reconoce ’admin’ y ’administrador’. Los roles privilegiados (administrador, soporte, qa) no se pueden autoasignar: el trigger perfiles_rol_inicial_seguro y protect_profile_sensitive_fields lo impiden. reputacion_cliente la actualiza el trigger al calificar al cliente.'
}

Table notificaciones {
  id text [pk, not null]
  id_usuario uuid [not null]
  tipo text [not null]
  titulo text [not null]
  cuerpo text [not null]
  id_relacionado text
  leido integer [not null, default: 0]
  creado_en text [not null]

  Note: 'Aviso dentro de la aplicación dirigido a un usuario.'
}

Table suscripciones {
  id text [pk, not null]
  id_usuario uuid [not null]
  tipo_plan text [not null]
  estado text [not null]
  fecha_inicio text [not null]
  fecha_fin text
  creado_en text [not null]
  actualizado_en text [not null]

  Note: 'Plan de suscripción contratado por un usuario.'
}

Table codigos_restablecimiento {
  id text [pk, not null]
  id_usuario uuid [not null]
  codigo text [not null]
  correo text [not null]
  expira_en text [not null]
  usado integer [default: 0]
  creado_en text [not null]

  Note: 'Código temporal para restablecer la contraseña.'
}

Table consentimientos_usuario {
  id text [pk, not null]
  id_usuario uuid [not null]
  version_consentimiento text [not null]
  aceptado integer [not null, default: 0]
  aceptado_en text [not null]
  direccion_ip text
  agente_usuario text

  Note: 'Registro de aceptación de una versión de consentimiento.'
}

Table bloqueos_usuario {
  id text [pk, not null]
  id_bloqueador uuid [not null]
  id_bloqueado uuid [not null]
  creado_en text [not null]

  indexes {
    (id_bloqueador, id_bloqueado) [unique]
  }

  Note: 'Bloqueo de un usuario hacia otro.'
}

Table reportes {
  id text [pk, not null]
  id_reportante uuid [not null]
  id_usuario_reportado uuid [not null]
  motivo text [not null]
  descripcion text
  estado text [not null, default: "'pending'"]
  creado_en text [not null]

  Note: 'Denuncia de un usuario contra otro.'
}

Table eventos_abuso {
  id text [pk, not null]
  id_usuario uuid [not null]
  tipo_abuso text [not null]
  conteo integer [not null]
  detectado_en text [not null]
  accion_tomada text
  accion_tomada_en text
  resuelto integer [default: 0]

  Note: 'Detección de abuso y la acción que se tomó.'
}

Table acciones_pendientes {
  id text [pk, not null]
  id_usuario uuid [not null]
  tipo_accion text [not null]
  tipo_entidad text [not null]
  id_entidad text
  datos text [not null]
  estado text [not null, default: "'pending_sync'"]
  conteo_reintentos integer [default: 0]
  mensaje_error text
  creado_en text [not null]
  actualizado_en text [not null]

  Note: 'Acción hecha sin conexión, pendiente de sincronizar.'
}

Table registros_error_app {
  id text [pk, not null]
  id_usuario uuid
  tipo_error text [not null, default: "'error'"]
  mensaje text [not null]
  traza_pila text
  metadatos jsonb
  estado text [not null, default: "'new'"]
  version_app text
  plataforma text
  creado_en text [not null, default: "to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD\"T\"HH24:MI:SS.US'::text)"]

  Note: 'Error de la aplicación informado por un cliente.'
}

Table eventos_analitica {
  id text [pk, not null]
  nombre_evento text [not null]
  id_usuario uuid
  rol text
  marca_tiempo text [not null]
  metadatos text

  Note: 'Evento de uso registrado por la aplicación.'
}

Table banderas_funcionalidad {
  id text [pk, not null]
  nombre_bandera text [not null]
  habilitada integer [not null, default: 0]
  version_app text
  rol text
  id_usuario uuid
  creado_en text [not null]
  actualizado_en text [not null]

  Note: 'Interruptor de una función por versión, rol o usuario.'
}

Table dispositivos_push {
  token text [pk, not null]
  id_usuario uuid [not null]
  plataforma text [not null, default: "'android'"]
  creado_en timestamptz [not null, default: now()]
  actualizado_en timestamptz [not null, default: now()]

  Note: 'Token del dispositivo del usuario para avisos push (FCM u otra plataforma). El alta y el baja se hacen por RPC.'
}

Table verificacion_eventos {
  id uuid [pk, not null, default: gen_random_uuid()]
  id_usuario uuid [not null]
  estado text [not null]
  nota text
  id_actor uuid
  creado_en timestamptz [not null, default: now()]

  Note: 'Historial de cambios del estado de verificación de un profesional (pendiente, en revisión, verificado, rechazado).'
}

Table paises {
  id text [pk, not null]
  nombre text [not null]
  iso2 text [not null]

  indexes {
    (iso2) [unique]
  }

  Note: 'País operativo. Hoy solo CL.'
}

Table regiones {
  id text [pk, not null]
  id_pais text [not null]
  nombre text [not null]
  codigo_oficial text

  Note: 'Región administrativa de un país.'
}

Table comunas {
  id text [pk, not null]
  id_region text [not null]
  nombre text [not null]
  latitud double precision
  longitud double precision
  activa integer [not null, default: 1]

  Note: 'Comuna de cobertura. Su identificador es el slug usado por trabajos y trabajadores.'
}

Table trabajadores {
  id_usuario uuid [pk, not null]
  profesion text [not null, default: "''"]
  descripcion text
  calificacion numeric(4,2) [not null, default: 0]
  disponible integer [not null, default: 1]
  tarifa_visita numeric(12,0) [not null, default: 15000]
  categoria_servicio text [not null, default: "'general'"]
  niveles_precio jsonb [not null, default: "'{}'"]
  conteo_rechazos integer [not null, default: 0, note: 'Rechazos de invitaciones; penaliza orden en listados (no visible en UI)']
  servicios_personalizados jsonb [not null, default: "'[]'", note: 'Servicios adicionales definidos por el trabajador (JSON array)']
  precios_configurados integer [not null, default: 0, note: '1 si el trabajador completó la guía de configuración de precios']
  zona_trabajo text [note: 'Comuna o zona donde atiende el trabajador']
  estado_verificacion text [not null, default: "'pendiente'"]
  nota_verificacion text
  latitud_base double precision [note: 'Latitud de la base de servicio. origen_base=comuna es el centro de la comuna declarada; mapa la fijó el profesional.']
  longitud_base double precision
  radio_servicio_km numeric [not null, default: 15, note: 'Radio máximo de matching en kilómetros desde la base.']
  origen_base text
  score_listado numeric(8,4) [not null, default: 0, note: 'Orden de marketplace. Incluye pesos configurables + prioridad_manual*2.']
  prioridad_manual integer [not null, default: 0, note: 'Override de admin (-50..50) para mostrar un profesional antes o después.']
  score_desglose jsonb [not null, default: "'{}'"]
  ranking_actualizado_en timestamptz
  radio_urbano_km numeric(5,2) [not null, default: 5, note: 'Kilómetros alrededor de la base donde la movilización es $0.']
  tarifa_fuera_radio_clp integer [not null, default: 0, note: 'Movilización fija si el cliente está fuera del radio urbano. 0 = tampoco cobra fuera.']
  trabajos_completados integer [not null, default: 0]
  es_elite boolean [note: 'GENERATED ALWAYS AS ((COALESCE(calificacion, (0)::numeric) >= 4.7) AND (trabajos_completados >= 5))']
  id_comuna text [note: 'Comuna de cobertura. zona_trabajo sigue como texto de UI.']
  id_region text [note: 'Cobertura regional (p. ej. RM todas).']
  usa_horario boolean [not null, default: false]
  pausa_por_trabajo boolean [not null, default: false, note: 'true cuando disponible = 0 lo dejó un trabajo activo; se restablece al terminar.']

  Note: 'Ficha 1:1 del profesional (PK = perfiles.id). La oferta en 4NF vive en tablas hijas; los JSON niveles_precio y servicios_personalizados son solo formato de escritura (un trigger los parte a filas). es_elite es una columna GENERATED. La agenda semanal está en trabajador_horarios; usa_horario enciende el filtro. pausa_por_trabajo queda en true cuando un trabajo activo dejó disponible = 0, y se restablece al terminar.'
}

Table trabajador_precios {
  id_usuario text [not null]
  codigo text [not null]
  monto_clp numeric(12,0) [not null]

  indexes {
    (id_usuario, codigo) [pk]
  }

  Note: 'Precio por código de servicio del profesional. En la base viva id_usuario es text (cast del uuid de trabajadores.id_usuario); no hay clave foránea física.'
}

Table trabajador_servicios_extra {
  id text [not null]
  id_usuario text [not null]
  titulo text [not null]
  subtitulo text [not null, default: "''"]
  monto_clp numeric(12,0) [not null]
  unidad text [not null, default: "'fijo'"]

  indexes {
    (id_usuario, id) [pk]
  }

  Note: 'Servicio adicional definido por el profesional. id_usuario es text en la base viva, igual que en trabajador_precios.'
}

Table trabajador_servicios {
  id_trabajador uuid [not null]
  categoria_servicio text [not null]

  indexes {
    (id_trabajador, categoria_servicio) [pk]
  }

  Note: 'Oficios del catálogo que el profesional declara atender.'
}

Table trabajador_horarios {
  id_usuario uuid [not null]
  horarios jsonb [not null, default: "'[]'"]
  actualizado_en timestamptz [not null, default: now()]
  id uuid [pk, not null, default: gen_random_uuid()]
  dia_semana smallint
  hora_inicio time
  hora_fin time
  activo boolean [default: true]
  creado_en timestamptz [default: now()]

  indexes {
    (id_usuario, dia_semana) [unique]
  }

  Note: 'Plantilla semanal: una fila por día (1 = lunes … 7 = domingo), única por (id_usuario, dia_semana). Solo el dueño lee y escribe (RLS). El cliente consulta los huecos con la RPC horarios_libres_profesional. usa_horario en trabajadores enciende el filtro.'
}

Table portafolio_trabajador {
  id text [pk, not null]
  id_trabajador uuid [not null]
  ruta_foto text [not null]
  descripcion text
  creado_en text [not null]
  tipo_medio text [default: "'photo'"]

  Note: 'Foto o medio del portafolio de un profesional.'
}

Table impulsos {
  id text [pk, not null]
  id_trabajador uuid [not null]
  tipo_impulso text [not null]
  fecha_inicio text [not null]
  fecha_fin text [not null]
  creado_en text [not null]

  Note: 'Promoción temporal de visibilidad de un profesional.'
}

Table servicios {
  id text [pk, not null]
  nombre text [not null]
  descripcion text
  categoria text [not null, default: "'general'"]
  activo integer [not null, default: 1]
  requiere_certificacion integer [not null, default: 0]
  modelo_precio text [not null, default: "'hourly'"]
  aviso_legal text
  creado_en text
  actualizado_en text

  Note: 'Catálogo de oficios que la plataforma ofrece.'
}

Table configuraciones_servicio {
  id text [pk, not null]
  id_servicio text [not null]
  esquema_config text [not null]
  creado_en text [not null]
  actualizado_en text [not null]

  indexes {
    (id_servicio) [unique]
  }

  Note: 'Esquema de configuración asociado a un servicio.'
}

Table trabajos {
  id text [pk, not null]
  id_usuario uuid [not null]
  id_trabajador uuid
  id_servicio text
  estado text [not null]
  direccion text [not null, default: "''"]
  latitud double precision
  longitud double precision
  descripcion text
  fecha_programada text
  metadatos_servicio text
  modalidad_cobro text
  estado_pago text
  id_comuna text [note: 'FK a comunas.id (slug).']
  instantanea_precio text
  id_sku_servicio text
  horas_bloque integer
  id_cotizacion_seleccionada text
  creado_en text [not null]
  actualizado_en text [not null]

  indexes {
    (id_trabajador) [unique, note: 'CREATE UNIQUE INDEX trabajos_trabajador_minuto_activo_uidx ON public.trabajos USING btree (id_trabajador, minuto_utc(fecha_programada)) WHERE ((fecha_programada IS NOT NULL) AND (id_trabajador IS NOT NULL) AND (estado <> ALL (ARRAY[’cancelado’::text, ’expirado’::text, ’completado’::text, ’no_asistio’::text])))']
  }

  Note: 'Pedido de un cliente a un profesional (o abierto a cotizaciones). estado_pago es una copia derivada del pago principal. La fecha programada se guarda como texto y, desde CU-33, solo cambia por las RPC de reagendamiento (trabajos_fecha_solo_por_rpc). Hay un índice único que impide dos trabajos activos del mismo profesional en el mismo minuto (minuto_utc de fecha_programada).'
}

Table mensajes {
  id text [pk, not null]
  id_trabajo text [not null]
  id_remitente uuid [not null]
  id_destinatario uuid [not null]
  contenido text [not null]
  tipo text [not null, default: "'text'"]
  ruta_imagen text
  leido integer [not null, default: 0]
  creado_en text [not null]

  Note: 'Mensaje del chat de un trabajo.'
}

Table fotos_trabajo {
  id text [pk, not null]
  id_trabajo text [not null]
  ruta_foto text [not null]
  creado_en text [not null]
  tipo_medio text [not null, default: "'photo'", note: 'photo or video evidence']
  imagen_webp bytea [note: 'Imagen de evidencia en WebP. Se guarda en la fila para no depender de archivos locales y ocupar menos espacio que JPEG/PNG.']

  Note: 'Evidencia fotográfica o de video de un trabajo (bucket de evidencias).'
}

Table calificaciones {
  id text [pk, not null]
  id_trabajo text [not null]
  id_usuario uuid
  puntaje integer [not null]
  comentario text
  creado_en text [not null]
  peso_confianza numeric(4,3) [not null, default: 1]
  estado_revision text [not null, default: "'vigente'"]
  motivo_revision text
  direccion text [not null, default: "'cliente_a_trabajador'"]
  id_calificado uuid

  indexes {
    (id_trabajo, direccion) [unique]
  }

  Note: 'Valoración de un trabajo. Desde la calificación bidireccional admite direccion cliente_a_trabajador o trabajador_a_cliente, con unicidad por (id_trabajo, direccion). Alimenta trabajadores.calificacion.'
}

Table calificaciones_cliente {
  id text [pk, not null]
  id_trabajo text [not null]
  id_cliente uuid [not null]
  id_trabajador uuid [not null]
  puntaje smallint [not null]
  comentario text
  creado_en timestamptz [not null, default: now()]

  indexes {
    (id_trabajo) [unique]
  }

  Note: 'El profesional nota al cliente. 1:1 con el trabajo. Alimenta perfiles.reputacion_cliente. puntaje es smallint en la base viva.'
}

Table disputas {
  id text [pk, not null]
  id_trabajo text [not null]
  abierta_por uuid [not null]
  motivo text [not null]
  descripcion text
  estado text [not null]
  resolucion text
  resuelta_por uuid
  resuelta_en text
  creado_en text [not null]
  actualizado_en text [not null]
  origen text [not null, default: "'admin'"]
  decision_sugerida text
  motivo_regla text
  vence_en timestamptz

  Note: 'Disputa abierta sobre un trabajo y su resolución (incluye sugerencia automática y vencimiento).'
}

Table disputa_mensajes {
  id text [pk, not null]
  id_disputa text [not null]
  id_autor uuid
  cuerpo text [not null]
  creado_en timestamptz [not null, default: now()]

  Note: 'Mensajes del hilo de una disputa, de las partes o de soporte.'
}

Table acuerdos_trabajo {
  id text [pk, not null]
  id_trabajo text [not null]
  tipo text [not null]
  propuesto_por uuid [not null]
  acepta_cliente boolean
  acepta_trabajador boolean
  estado text [not null, default: "'pendiente'"]
  creado_en timestamptz [not null, default: now()]
  aplicado_en timestamptz

  indexes {
    (id_trabajo) [unique, note: 'CREATE UNIQUE INDEX acuerdos_trabajo_pendiente_uidx ON public.acuerdos_trabajo USING btree (id_trabajo) WHERE (estado = ’pendiente’::text)']
  }

  Note: 'Acuerdo entre cliente y profesional para rehacer, aceptar o anular un trabajo. Como máximo un acuerdo pendiente por trabajo.'
}

Table cancelaciones_trabajo {
  id text [pk, not null]
  id_trabajo text [not null]
  cancelado_por uuid [not null]
  motivo text [not null]
  cancelado_en text [not null]

  indexes {
    (id_trabajo) [unique]
  }

  Note: 'Como máximo una cancelación por trabajo.'
}

Table tickets_soporte {
  id text [pk, not null, default: (gen_random_uuid())::text]
  id_trabajo text
  nombre_cliente text [not null]
  nombre_trabajador text [not null]
  asunto text [not null]
  monto_escrow integer [not null]
  estado text [default: "'Pending'"]
  creado_en timestamptz [default: now()]

  Note: 'Ticket de soporte asociado a un trabajo.'
}

Table ubicacion_en_vivo {
  id_trabajo text [pk, not null]
  id_trabajador uuid [not null]
  latitud double precision [not null]
  longitud double precision [not null]
  precision_metros double precision
  actualizado_en timestamptz [not null, default: now()]

  Note: 'GPS en vivo durante el trabajo. 1:1 con el trabajo.'
}

Table reprogramaciones_trabajo {
  id uuid [pk, not null, default: gen_random_uuid()]
  id_trabajo text [not null]
  propuesta_por uuid [not null]
  rol_proponente text [not null]
  fecha_anterior timestamptz [not null]
  fecha_propuesta timestamptz [not null]
  motivo text
  estado text [not null, default: "'pendiente'"]
  respondida_por uuid
  respondida_en timestamptz
  creado_en timestamptz [not null, default: now()]

  indexes {
    (id_trabajo) [unique, note: 'CREATE UNIQUE INDEX reprogramaciones_una_pendiente ON public.reprogramaciones_trabajo USING btree (id_trabajo) WHERE (estado = ’pendiente’::text)']
  }

  Note: 'Historial de propuestas para reagendar un trabajo (CU-33). Como máximo una propuesta pendiente por trabajo. Solo se escribe por las RPC proponer_reprogramacion, responder_reprogramacion y retirar_reprogramacion.'
}

Table pines_inicio_trabajo {
  id_trabajo text [pk, not null]
  pin text [not null]
  creado_en timestamptz [not null, default: now()]

  Note: 'PIN que el cliente muestra al profesional para iniciar el trabajo (aceptado o en_camino → en_curso). El cliente (o un administrador) puede leerlo; el profesional lo valida con intentar_pin_inicio o transicionar_trabajo. Lo crea el trigger trabajos_crear_pin_inicio.'
}

Table bloqueos_pin_inicio {
  id_trabajo text [pk, not null]
  fallos integer [not null, default: 0]
  bloqueado_hasta timestamptz
  pin_ok_hasta timestamptz
  pin_ok_usuario uuid
  actualizado_en timestamptz [not null, default: now()]

  Note: 'Contador de intentos fallidos del PIN, bloqueo temporal (15 minutos tras 5 fallos) y ventana en la que el PIN ya fue validado. RLS está activo y no hay políticas: solo acceden las funciones SECURITY DEFINER o el rol service_role.'
}

Table intentos_pin_inicio {
  id bigint [pk, not null]
  id_trabajo text [not null]
  id_usuario uuid
  resultado text [not null]
  intentos_restantes integer [not null]
  creado_en timestamptz [not null, default: now()]

  Note: 'Auditoría de cada intento de PIN de inicio. RLS activo sin políticas: solo funciones SECURITY DEFINER o service_role.'
}

Table propuestas_cotizacion {
  id text [pk, not null]
  id_trabajo text [not null]
  id_trabajador uuid [not null]
  monto_total_clp integer [not null]
  descripcion text [not null]
  validez_hasta text
  desglose text
  estado text [not null]
  creado_en text [not null]

  Note: 'Cotización que un profesional envía para un trabajo.'
}

Table pagos {
  id text [pk, not null]
  id_trabajo text [not null]
  id_orden_cambio text
  tipo_pago text [not null, default: "'primary'"]
  monto numeric(12,0) [not null]
  moneda text [not null, default: "'CLP'"]
  estado text [not null]
  metodo_pago text
  id_transaccion text
  autorizado_en text
  liberado_en text
  reembolsado_en text
  creado_en text [not null]
  actualizado_en text [not null]
  ambiente text [note: 'integration | production']
  token_tbk text [note: 'token_ws de Webpay Plus. No guardar aquí la orden Oneclick.']
  url_tbk text [note: 'URL TBK — solo service_role / Edge Functions']
  buy_order text [note: 'buy_order Webpay']
  handoff_consumido_en timestamptz
  reembolso_solicitado_en timestamptz [note: 'Marca que ya se pidió la devolución a Transbank. Un reintento no vuelve a llamar a la tarjeta.']
  orden_detalle_oneclick text [note: 'buy_order de detalle de Oneclick Mall, para el reembolso.']
  cobro_reclamado_en timestamptz [note: 'Marca exclusiva de una autorización Oneclick en curso.']
  origen_retorno text [note: 'Origen del navegador ya contrastado con la allowlist. webpay-commit redirige ahí.']
  alta_nonce_hash text [note: 'SHA-256 del nonce que solo tiene el navegador del invitado.']
  alta_jti text [note: 'Identificador de un solo uso del enlace para crear la contraseña.']
  alta_consumido_en timestamptz [note: 'Cuándo se usó el enlace. Un segundo intento no sirve.']

  indexes {
    (alta_jti) [unique, note: 'CREATE UNIQUE INDEX pagos_alta_jti_uidx ON public.pagos USING btree (alta_jti) WHERE (alta_jti IS NOT NULL)']
    (id_trabajo) [unique, note: 'CREATE UNIQUE INDEX pagos_un_principal_activo_uidx ON public.pagos USING btree (id_trabajo) WHERE ((tipo_pago = ’principal’::text) AND (estado = ANY (ARRAY[’pendiente’::text, ’retenido’::text, ’autorizado’::text])))']
  }

  Note: 'Cobro asociado a un trabajo o a una orden de cambio, con retención (escrow) vía Transbank Webpay / Oneclick. Las columnas alta_nonce_hash, alta_jti y alta_consumido_en sustentan el alta del invitado después del pago: el nonce solo lo tiene el navegador y el jti es de un solo uso. El default de tipo_pago es ’primary’ (inglés legado); el índice de un solo pago principal activo busca el valor ’principal’.'
}

Table ordenes_cambio {
  id text [pk, not null]
  id_trabajo text [not null]
  id_trabajador uuid [not null]
  tipo text [not null]
  titulo text [not null]
  descripcion text [not null]
  monto_clp integer [not null]
  estado text [not null, default: "'pending_client'"]
  id_pago text
  creado_en text [not null]
  respondido_en text

  Note: 'Cambio de alcance o de precio durante un trabajo.'
}

Table liquidaciones {
  id text [pk, not null, default: (gen_random_uuid())::text]
  id_pago text [not null]
  id_trabajo text [not null]
  id_trabajador text
  monto_clp numeric [not null]
  proveedor text [not null, default: "'manual'"]
  referencia_transferencia text [not null]
  notas text
  id_operador text [not null]
  creado_en timestamptz [not null, default: now()]
  estado_transferencia text [not null, default: "'transferido'"]

  indexes {
    (id_pago) [unique]
  }

  Note: 'Un pago → una liquidación al profesional. manual = transferencia externa confirmada por admin; khipu/fintoc = PSP futuro.'
}

Table metodos_pago_oneclick {
  id_usuario text [pk, not null]
  username text [not null]
  tbk_user text
  tipo_tarjeta text
  ultimos4 text
  estado text [not null, default: "'pendiente'"]
  token_inscripcion text
  id_trabajo_pendiente text
  creado_en timestamptz [not null, default: now()]
  actualizado_en timestamptz [not null, default: now()]
  url_inscripcion text
  ticket_handoff text

  indexes {
    (ticket_handoff) [unique, note: 'CREATE UNIQUE INDEX metodos_pago_oneclick_ticket_handoff_uidx ON public.metodos_pago_oneclick USING btree (ticket_handoff) WHERE (ticket_handoff IS NOT NULL)']
  }

  Note: 'Tarjeta inscrita Oneclick. RLS niega el acceso a anon y authenticated: solo service_role (Edge Functions).'
}

Table cuentas_bancarias {
  id_usuario uuid [pk, not null]
  banco text [not null]
  tipo_cuenta text [not null]
  numero_cuenta text [not null]
  rut_titular text [not null]
  nombre_titular text [not null]
  actualizado_en timestamptz [not null, default: now()]

  Note: 'Datos bancarios del profesional para pagar la liquidación. RLS: solo el dueño y un administrador. No es un dato público.'
}

Table app_config {
  clave text [pk, not null]
  valor text [not null]
  actualizado_en timestamptz [not null, default: now()]

  Note: 'Pares clave/valor de configuración (demo_modo, admin_requiere_aal2, etc.). RLS niega el acceso a clientes; lo lee el backend.'
}

Table ranking_config {
  id text [pk, not null, default: "'default'"]
  peso_calificacion numeric [not null, default: 0.32]
  peso_completados numeric [not null, default: 0.18]
  peso_rechazos numeric [not null, default: 0.12]
  peso_verificacion numeric [not null, default: 0.10]
  peso_impulso numeric [not null, default: 0.08]
  peso_recencia numeric [not null, default: 0.08]
  peso_confianza numeric [not null, default: 0.12]
  prior_bayes numeric [not null, default: 3.80]
  n_bayes numeric [not null, default: 8]
  umbral_revision numeric [not null, default: 0.55]
  umbral_auto_excluir numeric [not null, default: 0.90]
  aprendizaje_activo integer [not null, default: 1]
  tasa_aprendizaje numeric [not null, default: 0.15]
  pesos_senal jsonb [not null, default: "'{\"rafaga\": 0.45, \"outlier\": 0.22, \"auto_resena\": 1.00, \"cuenta_nueva\": 0.25, \"duplicado_texto\": 0.40, \"sin_trabajo_valido\": 0.95, \"texto_vacio_extremo\": 0.20, \"granja_cinco_estrellas\": 0.50}'"]
  actualizado_en timestamptz [not null, default: now()]

  Note: 'Una fila default. Pesos del listado de profesionales.'
}

Table senales_resena {
  id text [pk, not null]
  id_calificacion text [not null]
  tipo_senal text [not null]
  puntaje numeric [not null]
  detalle text
  estado text [not null, default: "'pendiente'"]
  resuelto_por uuid
  resuelto_en timestamptz
  creado_en timestamptz [not null, default: now()]

  indexes {
    (id_calificacion, tipo_senal) [unique]
  }

  Note: 'Señales de reseña dudosa. Un falso positivo baja el peso de esa señal.'
}

Table ranking_aprendizaje {
  id text [pk, not null]
  motivo text [not null]
  pesos_antes jsonb [not null]
  pesos_despues jsonb [not null]
  metricas jsonb
  creado_en timestamptz [not null, default: now()]

  Note: 'Ajuste de los pesos del ranking y las métricas de ese cambio.'
}

Table eventos_ranking {
  id text [pk, not null]
  id_trabajador uuid [not null]
  id_trabajo text
  tipo_evento text [not null]
  factores jsonb [not null, default: "'{}'"]
  creado_en timestamptz [not null, default: now()]

  Note: 'Evento que alimenta el ranking de un profesional.'
}

// ---------------------------------------------------------------------------
// Relaciones (solo FK físicas de la BD viva)
// ---------------------------------------------------------------------------

Ref: notificaciones.id_usuario > perfiles.id [delete: cascade]
Ref: suscripciones.id_usuario > perfiles.id [delete: cascade]
Ref: consentimientos_usuario.id_usuario > perfiles.id [delete: cascade]
Ref: eventos_abuso.id_usuario > perfiles.id [delete: cascade]
Ref: acciones_pendientes.id_usuario > perfiles.id [delete: cascade]
Ref: registros_error_app.id_usuario > perfiles.id
Ref: dispositivos_push.id_usuario > perfiles.id [delete: cascade]
Ref: verificacion_eventos.id_usuario > perfiles.id [delete: cascade]
Ref: regiones.id_pais > paises.id
Ref: comunas.id_region > regiones.id
Ref: trabajadores.id_comuna > comunas.id [delete: set_null]
Ref: trabajadores.id_region > regiones.id [delete: set_null]
Ref: trabajadores.id_usuario - perfiles.id [delete: cascade]
Ref: trabajador_servicios.id_trabajador > perfiles.id [delete: cascade]
Ref: trabajador_horarios.id_usuario > trabajadores.id_usuario [delete: cascade]
Ref: portafolio_trabajador.id_trabajador > perfiles.id [delete: cascade]
Ref: impulsos.id_trabajador > perfiles.id [delete: cascade]
Ref: configuraciones_servicio.id_servicio > servicios.id [delete: cascade]
Ref: trabajos.id_servicio > servicios.id [delete: set_null]
Ref: trabajos.id_usuario > perfiles.id [delete: cascade]
Ref: trabajos.id_trabajador > perfiles.id [delete: set_null]
Ref: trabajos.id_comuna > comunas.id [delete: set_null]
Ref: mensajes.id_trabajo > trabajos.id [delete: cascade]
Ref: fotos_trabajo.id_trabajo > trabajos.id [delete: cascade]
Ref: calificaciones.id_trabajo > trabajos.id [delete: cascade]
Ref: disputas.id_trabajo > trabajos.id [delete: cascade]
Ref: disputa_mensajes.id_autor > perfiles.id
Ref: disputa_mensajes.id_disputa > disputas.id [delete: cascade]
Ref: acuerdos_trabajo.id_trabajo > trabajos.id [delete: cascade]
Ref: acuerdos_trabajo.propuesto_por > perfiles.id
Ref: cancelaciones_trabajo.id_trabajo > trabajos.id [delete: cascade]
Ref: ubicacion_en_vivo.id_trabajo - trabajos.id [delete: cascade]
Ref: ubicacion_en_vivo.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: reprogramaciones_trabajo.id_trabajo > trabajos.id [delete: cascade]
Ref: pines_inicio_trabajo.id_trabajo - trabajos.id [delete: cascade]
Ref: bloqueos_pin_inicio.id_trabajo - trabajos.id [delete: cascade]
Ref: propuestas_cotizacion.id_trabajo > trabajos.id [delete: cascade]
Ref: propuestas_cotizacion.id_trabajador > perfiles.id [delete: cascade]
Ref: pagos.id_trabajo > trabajos.id [delete: cascade]
Ref: ordenes_cambio.id_trabajo > trabajos.id [delete: cascade]
Ref: liquidaciones.id_pago > pagos.id
Ref: liquidaciones.id_trabajo > trabajos.id
Ref: cuentas_bancarias.id_usuario - perfiles.id [delete: cascade]
Ref: senales_resena.id_calificacion > calificaciones.id [delete: cascade]

// Grupos para el lienzo de dbdiagram.io

TableGroup identidad {
  perfiles
  notificaciones
  suscripciones
  codigos_restablecimiento
  consentimientos_usuario
  bloqueos_usuario
  reportes
  eventos_abuso
  acciones_pendientes
  registros_error_app
  eventos_analitica
  banderas_funcionalidad
  dispositivos_push
  verificacion_eventos
}

TableGroup territorio {
  paises
  regiones
  comunas
}

TableGroup catalogo_4nf {
  trabajadores
  trabajador_precios
  trabajador_servicios_extra
  trabajador_servicios
  trabajador_horarios
  portafolio_trabajador
  impulsos
  servicios
  configuraciones_servicio
}

TableGroup pedido {
  trabajos
  mensajes
  fotos_trabajo
  calificaciones
  calificaciones_cliente
  disputas
  disputa_mensajes
  acuerdos_trabajo
  cancelaciones_trabajo
  tickets_soporte
  ubicacion_en_vivo
  reprogramaciones_trabajo
  pines_inicio_trabajo
  bloqueos_pin_inicio
  intentos_pin_inicio
}

TableGroup cobro {
  propuestas_cotizacion
  pagos
  ordenes_cambio
  liquidaciones
  metodos_pago_oneclick
  cuentas_bancarias
  app_config
}

TableGroup ranking {
  ranking_config
  senales_resena
  ranking_aprendizaje
  eventos_ranking
}
